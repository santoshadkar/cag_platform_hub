# Environment Configuration for CAG Developer Copilot
# Zero-Hardcoding compliance per Enterprise Engineering Standards

APP_ENV=production
APP_PORT=8000
DEBUG=false

# LLM & Cache Provider Settings
LLM_PROVIDER=gemini_context_caching
MODEL_NAME=gemini-1.5-pro-latest
API_KEY=mock-enterprise-api-key-safe-cab-approved

# Cache Lifecycle Configurations
DEFAULT_CACHE_TTL_SECONDS=3600
MIN_CACHE_TOKEN_THRESHOLD=2048
CACHE_EVICTION_STRATEGY=LRU

# Pricing reference ($ per 1M tokens) for ROI tracking
# Base pricing Gemini / Claude prompt caching benchmarks:
UNCACHED_INPUT_PRICE_PER_M=3.50
CACHED_INPUT_PRICE_PER_M=0.875
OUTPUT_PRICE_PER_M=10.50
